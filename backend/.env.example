# Backend Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Environment
ENVIRONMENT=development

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8001

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AMD Cloud API Configuration
AMD_API_KEY=
AMD_API_URL=https://api.amd.cloud/v1
AMD_MODEL_ENDPOINT=http://localhost:8000/v1/chat/completions
AMD_MODEL_NAME=Qwen/Qwen3-32B
AMD_GPU_TARGET=AMD MI300X

# vLLM Configuration (for local AMD MI300X inference)
VLLM_API_KEY=
VLLM_API_URL=http://localhost:8000
VLLM_MODEL_NAME=Qwen/Qwen3-32B
VLLM_ENABLED=true

# AMD GPU Configuration
AMD_GPU_ENABLED=true
ROCM_VERSION=6.2
MODEL_NAME=Qwen/Qwen3-32B

# Logging
LOG_LEVEL=INFO

# Notes for AMD MI300X Droplet Setup:
# 1. vLLM runs on port 8000
# 2. FastAPI backend runs on port 8001
# 3. AMD_MODEL_ENDPOINT should point to vLLM: http://localhost:8000/v1/chat/completions
# 4. On the droplet, both services run on the same machine
# 5. For remote access, replace localhost with your droplet IP

# Model Configuration:
# Primary Model: Qwen/Qwen3-32B (recommended for AMD MI300X)
# - Stronger reasoning capabilities for AI Advisor
# - Better command interpretation and action selection
# - Improved agricultural knowledge understanding
#
# Fallback Model: Qwen/Qwen2.5-32B-Instruct
# - Use if Qwen3-32B is not available
# - Still provides good performance for agent reasoning
#
# vLLM Launch Commands:
#
# Primary (Qwen3-32B):
# python -m vllm.entrypoints.openai.api_server \
#   --model Qwen/Qwen3-32B \
#   --host 0.0.0.0 \
#   --port 8000 \
#   --max-model-len 32768
#
# Fallback (Qwen2.5-32B-Instruct):
# python -m vllm.entrypoints.openai.api_server \
#   --model Qwen/Qwen2.5-32B-Instruct \
#   --host 0.0.0.0 \
#   --port 8000 \
#   --max-model-len 32768
#
# Note: The LLM is used for agent reasoning and tool/action selection.
# Orchard detection is handled by dedicated services:
# - orchard_detection_service
# - satellite_imagery_service
# - orchard_detector
# - vision/3D pipeline