# Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git

# Environment
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AMD Cloud API Configuration
# Get your API key from: https://www.amd.com/en/developer/resources/developer-cloud.html
AMD_API_KEY=your_amd_api_key_here
AMD_API_URL=https://api.amd.cloud/v1

# AMD vLLM Endpoint Configuration
# Set this to your vLLM server URL (e.g., http://localhost:8000 or https://your-mi300x-instance.com:8000)
# The client will append /v1/chat/completions automatically
AMD_MODEL_ENDPOINT=

# AMD Model Configuration
AMD_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
AMD_GPU_TARGET=AMD MI300X

# vLLM Configuration (for LLM inference)
VLLM_API_KEY=
VLLM_API_URL=
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# HuggingFace Configuration (for model downloads)
HUGGINGFACE_TOKEN=

# AMD GPU Configuration
AMD_GPU_ENABLED=false
ROCM_VERSION=5.7

# AI Model Configuration
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
MODEL_PATH=/models
VLLM_ENABLED=false

# Database Configuration (Future)
# DATABASE_URL=postgresql://user:password@localhost:5432/avocado_orchard

# Redis Configuration (Future)
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO