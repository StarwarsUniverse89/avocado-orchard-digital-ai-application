# Backend Environment Configuration
# Copy this file to backend/.env and fill in private values.
# NEVER commit backend/.env to git.

ENVIRONMENT=development

API_HOST=0.0.0.0
API_PORT=8001

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

AMD_API_KEY=
AMD_API_URL=https://api.amd.cloud/v1
AMD_MODEL_ENDPOINT=http://localhost:8000/v1/chat/completions
AMD_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
AMD_GPU_TARGET=AMD MI300X

VLLM_API_KEY=
VLLM_API_URL=http://localhost:8000
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
VLLM_ENABLED=true

HUGGINGFACE_TOKEN=

AMD_GPU_ENABLED=true
ROCM_VERSION=7.2

MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
MODEL_PATH=/models

LOG_LEVEL=INFO