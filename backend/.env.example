# Backend Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Environment
ENVIRONMENT=development

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8001

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AMD Cloud API Configuration
AMD_API_KEY=
AMD_API_URL=https://api.amd.cloud/v1
AMD_MODEL_ENDPOINT=http://localhost:8000/v1/chat/completions
AMD_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
AMD_GPU_TARGET=AMD MI300X

# vLLM Configuration (for local AMD MI300X inference)
VLLM_API_KEY=
VLLM_API_URL=http://localhost:8000
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
VLLM_ENABLED=true

# AMD GPU Configuration
AMD_GPU_ENABLED=true
ROCM_VERSION=6.2
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Logging
LOG_LEVEL=INFO

# Notes for AMD MI300X Droplet Setup:
# 1. vLLM runs on port 8000
# 2. FastAPI backend runs on port 8001
# 3. AMD_MODEL_ENDPOINT should point to vLLM: http://localhost:8000/v1/chat/completions
# 4. On the droplet, both services run on the same machine
# 5. For remote access, replace localhost with your droplet IP